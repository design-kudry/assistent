{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@consta/uikit/*": [
        "./node_modules/@consta/uikit/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "@gravity-ui/icons/*": [
        "./node_modules/@gravity-ui/icons/*"
      ],
      "@consta/icons/*": [
        "./node_modules/@consta/icons/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "../examples/*.tsx",
    "../presets/*.ts",
    "../index.ts",
    "../typography.ts",
    "main.tsx"
  ]
}
